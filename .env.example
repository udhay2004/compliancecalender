ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# MongoDB Atlas connection string (create a free cluster at
# https://cloud.mongodb.com, add a database user, allow network access,
# then copy the connection string here). Example shape:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/compliance_calendar
MONGODB_URI=mongodb+srv://xxxx:xxxx@xxxx.mongodb.net/compliance_calendar

# Any long random string — used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Optional overrides:
# ANTHROPIC_MODEL=claude-sonnet-5
# PORT=3000
# NODE_ENV=production
