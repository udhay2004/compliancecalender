# .env.example — every setting the app understands.
# Locally: copy to .env and fill in. On Railway: add these under
# your service → Variables (no quotes needed), then redeploy.
# Lines starting with # are optional or examples.

# =====================================================================
# REQUIRED
# =====================================================================
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MONGODB_URI=mongodb+srv://xxxx:xxxx@xxxx.mongodb.net/compliance_calendar
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
# Your site's address, no trailing slash. Used in emails, webhooks and calendar links.
APP_URL=https://yourapp.up.railway.app
NODE_ENV=production

# ANTHROPIC_MODEL=claude-sonnet-5
# PORT=3000

# =====================================================================
# EMAIL (one of: Resend, or any SMTP provider)
# Without these, emails are only written to the log.
# =====================================================================
# RESEND_API_KEY=re_xxxxxxxx
# SMTP_HOST=smtp.postmarkapp.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=ComplyGlobally <no-reply@complyglobally.com>
# SMTP_FROM=
# Team inbox for new-client alerts when no staff member is assigned.
ADMIN_EMAIL=you@complyglobally.com

# =====================================================================
# DOCUMENT STORAGE — Cloudflare R2 (files are LOST on redeploy without it)
# =====================================================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# (S3_ENDPOINT / S3_BUCKET / S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY also work.)
# STORAGE_DRIVER=s3
# LOCAL_UPLOAD_DIR=./uploads

# =====================================================================
# PAYMENTS — Razorpay
# =====================================================================
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=
# Razorpay → Webhooks → URL <APP_URL>/api/webhooks/razorpay, events:
# payment.captured, payment.failed, order.paid, refund.created,
# refund.processed, refund.failed
RAZORPAY_WEBHOOK_SECRET=
# USD needs "International Payments" activated on your Razorpay account.
PAYMENT_CURRENCY=USD
# Only when PAYMENT_CURRENCY=INR:
# USD_TO_INR_RATE=84

# =====================================================================
# INVOICES (Indian GST — export of services)
# =====================================================================
# GSTIN=
# LUT_ARN=
# INVOICE_SAC_CODE=998231
# INVOICE_PREFIX=INV
# CREDIT_NOTE_PREFIX=CN

# =====================================================================
# BUSINESS DETAILS (legal pages, invoices, footer)
# =====================================================================
BUSINESS_LEGAL_NAME=
# Parts separated by |  e.g.  Office 12|MG Road|Bengaluru 560001|India
BUSINESS_ADDRESS=
SUPPORT_EMAIL=support@complyglobally.com
SUPPORT_PHONE=
JURISDICTION_CITY=
# BUSINESS_HOURS=Monday to Friday, 10:00 to 18:00 IST
# CIN=
# GRIEVANCE_OFFICER_NAME=
# GRIEVANCE_OFFICER_EMAIL=
# POLICIES_LAST_UPDATED=24 September 2026
# REFUND_PROCESSING_DAYS=5 to 7 business days
# DOCS_LEAD_TIME_DAYS=10

# =====================================================================
# SECURITY
# =====================================================================
# Encrypts staff two-factor secrets. Set once and never change it.
TOTP_ENCRYPTION_KEY=
# TWO_FACTOR_REQUIRED=true
# CSP_REPORT_ONLY=false

# =====================================================================
# SIGN IN WITH GOOGLE (optional)
# =====================================================================
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=https://yourapp.up.railway.app/api/auth/google/callback

# =====================================================================
# BACKUPS (to R2, nightly)
# =====================================================================
# BACKUP_CRON=30 2 * * *
# DISABLE_BACKUPS=false
# BACKUP_SKIP_COLLECTIONS=

# =====================================================================
# REMINDERS AND DOCUMENT CHASING (daily)
# =====================================================================
# REMINDER_CRON=0 8 * * *
# DISABLE_REMINDERS=false
# Also remind clients about filings they haven't asked us to handle:
# REMIND_UNSELECTED=true
# Days between payment-overdue reminders:
# REMINDER_COOLDOWN_DAYS=7
# Automatic "please upload your documents" reminders:
# DOC_CHASING=true
# Days after the client selects a service:
# DOC_CHASE_DAYS=2,5,10
# Then every N days:
# DOC_CHASE_REPEAT_DAYS=7
# Never more than this many per filing:
# DOC_CHASE_MAX=8

# =====================================================================
# WHATSAPP — Meta WhatsApp Cloud API (optional)
# Without WHATSAPP_TOKEN + WHATSAPP_PHONE_NUMBER_ID, messages are only logged.
# Admin → WhatsApp shows what's missing and the template wording to submit.
# =====================================================================
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_API_VERSION=v24.0
# WHATSAPP_TEMPLATE_LANG=en
# WHATSAPP_TEMPLATE_UPDATE=account_update
# WHATSAPP_TEMPLATE_DEADLINE=deadline_reminder
# WHATSAPP_TEMPLATE_DOCUMENTS=documents_needed
# For numbers typed without +country code (10 digits), e.g. 1 for US:
# WHATSAPP_DEFAULT_COUNTRY_CODE=1
# Which client events also go to WhatsApp (the daily digest always does):
# WHATSAPP_EVENTS=quote_sent,document_rejected,certificate_uploaded,documents_requested,message
