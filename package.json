{
  "name": "compliance-calendar-webapp",
  "version": "2.0.0",
  "description": "ComplyGlobally: AI-researched compliance calendars with a client portal, staff workspace, payments, reminders and reports.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed:states": "node scripts/seedStates.js",
    "seed:odi": "node scripts/seedOdi.js",
    "load:states": "node scripts/loadPresearchedStates.js",
    "test": "node --test tests/*.test.js",
    "seed:team": "node scripts/seedTeam.js"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@aws-sdk/client-s3": "^3.1111.0",
    "@sentry/node": "^11.0.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "google-auth-library": "^11.0.2",
    "jsonrepair": "^3.8.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.15.0",
    "razorpay": "^2.9.8"
  }
}
